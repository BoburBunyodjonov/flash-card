generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  uz
  en
  ru
}

enum Difficulty {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum WordStatus {
  new
  learning
  learned
  mastered
}

enum PaymentProvider {
  telegram_stars
  payme
  click
  stripe
}

enum PlanType {
  monthly
  annual
  lifetime
}

enum PaymentStatus {
  pending
  success
  failed
}

enum DuelStatus {
  pending
  active
  completed
  expired
}

enum Gender {
  male
  female
}

enum SpeakingStatus {
  active
  ended
}

model User {
  id           String    @id @default(uuid())
  // Nullable: a user may sign up with phone+password instead of Telegram
  telegramId   BigInt?   @unique @map("telegram_id")
  phone        String?   @unique
  passwordHash String?   @map("password_hash")
  username     String?
  firstName    String    @map("first_name")
  lastName     String?   @map("last_name")
  avatarUrl    String?   @map("avatar_url")
  language     Language  @default(uz)
  isAdmin      Boolean   @default(false) @map("is_admin")
  isPremium    Boolean   @default(false) @map("is_premium")
  premiumUntil DateTime? @map("premium_until")
  streak       Int       @default(0)
  // Streak freezes auto-protect the streak when the user misses a single day
  streakFreezes Int      @default(2) @map("streak_freezes")
  lastActive   DateTime? @map("last_active")
  xp           Int       @default(0)
  cefrLevel    Difficulty? @map("cefr_level")
  onboardingDone Boolean   @default(false) @map("onboarding_done")
  gender       Gender?
  leagueTier   Int       @default(0) @map("league_tier")
  referredById String?   @map("referred_by")
  notifyAt      String   @default("20:00") @map("notify_at")
  notifyEnabled Boolean  @default(true) @map("notify_enabled")
  // Set by admins to bar an abusive user from the Speaking (voice) feature until this time
  speakingBannedUntil DateTime? @map("speaking_banned_until")
  createdAt    DateTime  @default(now()) @map("created_at")

  referredBy   User?              @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]             @relation("Referrals")
  wordProgress UserWordProgress[]
  decks        UserDeck[]
  followers    Follow[]           @relation("Following")
  following    Follow[]           @relation("Follower")
  payments     Payment[]
  createdWords Word[]
  updatedSettings PlanSetting[]
  duelsCreated   Duel[]           @relation("DuelChallenger")
  duelsReceived  Duel[]           @relation("DuelOpponent")
  leagueEntries  LeagueMember[]
  speakingAsA    SpeakingSession[] @relation("SpeakingUserA")
  speakingAsB    SpeakingSession[] @relation("SpeakingUserB")
  speakingReports SpeakingReport[]
  userWords    UserWord[]
  achievements UserAchievement[]
  gcCreated    GroupChallenge[]      @relation("GcCreator")
  gcEntries    GroupChallengeEntry[] @relation("GcEntrant")
  pushTokens   PushToken[]
  shadowingDone ShadowingCompletion[]
  integrationEnrollments IntegrationEnrollment[]
  integrationStaff       IntegrationStaff[]
  wordSharesSent         WordShare[] @relation("WordShareFrom")
  wordSharesReceived     WordShare[] @relation("WordShareTo")
  wordsSharedFromMe      UserWord[]  @relation("SharedWordSource")

  @@map("users")
}

// FCM device tokens for push notifications (Flutter mobile app). A user may have
// several (one per device). `token` is globally unique — on re-register it is
// reassigned to whichever user last logged in on that device.
model PushToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String?  // "android" | "ios" | "web"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// One row per achievement a user has unlocked. The unique constraint makes the
// XP reward idempotent — an achievement can only ever be inserted (and rewarded) once.
model UserAchievement {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  code       String
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId])
  @@map("user_achievements")
}

model UserWord {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  word          String                              // English word/phrase
  translation   String                              // user's own Uzbek translation
  pronunciation String?
  audioUrl      String?    @map("audio_url")
  partOfSpeech  String?    @map("part_of_speech")
  definitionEn  String?    @map("definition_en")
  exampleEn     String?    @map("example_en")
  synonyms      String[]   @default([])
  strength      Int        @default(0)
  status        WordStatus @default(new)
  nextReview    DateTime?  @map("next_review")
  reviewCount   Int        @default(0) @map("review_count")
  lastReviewed  DateTime?  @map("last_reviewed")
  createdAt     DateTime   @default(now()) @map("created_at")

  // Peer share provenance (null = self-added or teacher pack)
  sharedFromUserId String? @map("shared_from_user_id")
  sharedFromName   String? @map("shared_from_name")
  sourceShareId    String? @map("source_share_id")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedFromUser User?          @relation("SharedWordSource", fields: [sharedFromUserId], references: [id], onDelete: SetNull)
  sourceShare    WordShare?     @relation(fields: [sourceShareId], references: [id], onDelete: SetNull)

  sourcePackId String?         @map("source_pack_id")
  sourcePack   TeacherWordPack? @relation(fields: [sourcePackId], references: [id], onDelete: SetNull)

  @@unique([userId, word])
  @@index([userId])
  @@index([sourceShareId])
  @@map("user_words")
}

enum WordShareStatus {
  pending
  accepted
  declined
}

// Peer-to-peer My Words share invite (one recipient per row).
model WordShare {
  id          String          @id @default(uuid())
  fromUserId  String          @map("from_user_id")
  toUserId    String          @map("to_user_id")
  status      WordShareStatus @default(pending)
  createdAt   DateTime        @default(now()) @map("created_at")
  respondedAt DateTime?       @map("responded_at")

  fromUser User @relation("WordShareFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("WordShareTo", fields: [toUserId], references: [id], onDelete: Cascade)
  items    WordShareItem[]
  acceptedWords UserWord[]

  @@index([toUserId, status])
  @@index([fromUserId])
  @@map("word_shares")
}

model WordShareItem {
  id            String  @id @default(uuid())
  shareId       String  @map("share_id")
  word          String
  translation   String
  pronunciation String?
  audioUrl      String? @map("audio_url")
  partOfSpeech  String? @map("part_of_speech")
  definitionEn  String? @map("definition_en")
  exampleEn     String? @map("example_en")
  synonyms      String[] @default([])

  share WordShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId])
  @@map("word_share_items")
}

model SpeakingSession {
  id          String         @id @default(uuid())
  userAId     String         @map("user_a_id")
  userBId     String         @map("user_b_id")
  status      SpeakingStatus @default(active)
  startedAt   DateTime       @default(now()) @map("started_at")
  endedAt     DateTime?      @map("ended_at")
  durationSec Int?           @map("duration_sec")
  ratingByA   Boolean?       @map("rating_by_a")
  ratingByB   Boolean?       @map("rating_by_b")

  userA   User             @relation("SpeakingUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB   User             @relation("SpeakingUserB", fields: [userBId], references: [id], onDelete: Cascade)
  reports SpeakingReport[]

  @@index([userAId])
  @@index([userBId])
  @@map("speaking_sessions")
}

model SpeakingReport {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  reporterId String   @map("reporter_id")
  reason     String
  // Null until an admin reviews it; set when the report is actioned/dismissed
  resolvedAt DateTime? @map("resolved_at")
  resolution String?   // free-text admin note (e.g. "banned 7d", "dismissed")
  createdAt  DateTime @default(now()) @map("created_at")

  session  SpeakingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reporter User            @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([resolvedAt])
  @@map("speaking_reports")
}

model Duel {
  id              String     @id @default(uuid())
  challengerId    String     @map("challenger_id")
  opponentId      String?    @map("opponent_id")
  status          DuelStatus @default(pending)
  questions       Json
  challengerScore Int?       @map("challenger_score")
  opponentScore   Int?       @map("opponent_score")
  challengerTime  Int?       @map("challenger_time")
  opponentTime    Int?       @map("opponent_time")
  winnerId        String?    @map("winner_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  completedAt     DateTime?  @map("completed_at")

  challenger User  @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User? @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([challengerId])
  @@index([opponentId])
  @@map("duels")
}

// A multiplayer quiz race: the creator generates a shared question set, shares a
// deep link, and any number of friends play the same questions. Each player gets
// one scored entry; the leaderboard ranks by score then time.
model GroupChallenge {
  id        String   @id @default(uuid())
  creatorId String   @map("creator_id")
  questions Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  creator User                  @relation("GcCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  entries GroupChallengeEntry[]

  @@index([creatorId])
  @@map("group_challenges")
}

model GroupChallengeEntry {
  id          String    @id @default(uuid())
  challengeId String    @map("challenge_id")
  userId      String    @map("user_id")
  score       Int       @default(0)
  timeMs      Int       @default(0) @map("time_ms")
  completedAt DateTime? @map("completed_at")
  joinedAt    DateTime  @default(now()) @map("joined_at")

  challenge GroupChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User           @relation("GcEntrant", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@map("group_challenge_entries")
}

model LeagueMember {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  weekStart DateTime @map("week_start")
  groupId   String   @map("group_id")
  tier      Int      @default(0)
  weeklyXp  Int      @default(0) @map("weekly_xp")
  finalRank Int?     @map("final_rank")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([groupId])
  @@index([weekStart])
  @@map("league_members")
}

model Category {
  id        String   @id @default(uuid())
  nameUz    String   @map("name_uz")
  nameEn    String   @map("name_en")
  nameRu    String   @map("name_ru")
  icon      String?
  color     String   @default("#6366f1")
  isPremium Boolean  @default(false) @map("is_premium")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  words          Word[]
  shadowingClips ShadowingClip[]

  @@map("categories")
}

model Word {
  id           String     @id @default(uuid())
  word         String     @unique
  pronunciation String?
  audioUrl     String?    @map("audio_url")
  imageUrl     String?    @map("image_url")
  videoUrl     String?    @map("video_url")
  partOfSpeech String?    @map("part_of_speech")
  difficulty   Difficulty @default(A1)
  categoryId   String     @map("category_id")
  createdById  String?    @map("created_by")
  createdAt    DateTime   @default(now()) @map("created_at")

  category     Category          @relation(fields: [categoryId], references: [id])
  createdBy    User?             @relation(fields: [createdById], references: [id])
  translations WordTranslation[]
  userProgress UserWordProgress[]
  deckWords    DeckWord[]

  @@map("words")
}

model WordTranslation {
  id                String   @id @default(uuid())
  wordId            String   @map("word_id")
  language          Language
  translation       String?
  definitionEn      String?  @map("definition_en")
  exampleEn         String?  @map("example_en")
  exampleTranslated String?  @map("example_translated")

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([wordId, language])
  @@map("word_translations")
}

model UserWordProgress {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  wordId       String     @map("word_id")
  status       WordStatus @default(new)
  strength     Int        @default(0)
  nextReview   DateTime?  @map("next_review")
  reviewCount  Int        @default(0) @map("review_count")
  lastReviewed DateTime?  @map("last_reviewed")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@map("user_word_progress")
}

model UserDeck {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  words DeckWord[]

  @@map("user_decks")
}

model DeckWord {
  id      String   @id @default(uuid())
  deckId  String   @map("deck_id")
  wordId  String   @map("word_id")
  addedAt DateTime @default(now()) @map("added_at")

  deck UserDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  word Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([deckId, wordId])
  @@map("deck_words")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model PlanSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by")

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("plan_settings")
}

model Payment {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  amount    Decimal
  currency  String
  provider  PaymentProvider
  planType  PlanType        @map("plan_type")
  status    PaymentStatus   @default(pending)
  meta      Json?
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("payments")
}

// Shadowing practice: short native-speaker video clips the learner repeats
// ("shadows"). The video file itself lives in a private Telegram channel and is
// fetched on demand via MTProto (GramJS) — nothing is stored on our server
// except this metadata row. `tgMessageId` points at the channel post.
model ShadowingClip {
  id            String     @id @default(uuid())
  title         String
  // Telegram source (channel id + message id within it).
  tgChannelId   String     @map("tg_channel_id")
  tgMessageId   Int        @map("tg_message_id")
  durationSec   Int?       @map("duration_sec")
  // The English text the learner shadows, and its Uzbek translation.
  transcript    String
  translationUz String     @map("translation_uz")
  // Optional line-by-line timing for A-B segment repeat:
  // [{ start: number, end: number, text: string, translation?: string }]
  segments      Json?
  level         Difficulty @default(A1)
  categoryId    String?    @map("category_id")
  order         Int        @default(0)
  isPublished   Boolean    @default(true) @map("is_published")
  createdAt     DateTime   @default(now()) @map("created_at")

  category    Category?             @relation(fields: [categoryId], references: [id])
  completions ShadowingCompletion[]

  @@unique([tgChannelId, tgMessageId])
  @@index([level])
  @@index([isPublished])
  @@map("shadowing_clips")
}

// One row per (user, clip) — records that a learner has shadowed a clip and how
// many times. The unique constraint makes the first-completion XP idempotent.
model ShadowingCompletion {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  clipId    String   @map("clip_id")
  count     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clip ShadowingClip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@unique([userId, clipId])
  @@index([userId])
  @@map("shadowing_completions")
}

// ---------------------------------------------------------------------------
// ERP / o'quv markaz integratsiyasi (universal Partner API)
// Har qanday ERP REST orqali o'quvchi ro'yxatini sinxronlaydi.
// ---------------------------------------------------------------------------

enum PartnerStatus {
  active
  suspended
}

enum PartnerAccessMode {
  // Ro'yxatdagi tel premium/ imtiyoz oladi; boshqalar oddiy user sifatida ishlaydi
  benefit_only
  // Faqat ro'yxatdagi telefonlar kirish / ro'yxatdan o'tish mumkin
  whitelist
}

enum EnrollmentStatus {
  active
  inactive
}

model Partner {
  id              String            @id @default(uuid())
  name            String
  slug            String            @unique
  apiKeyHash      String            @map("api_key_hash")
  apiKeyPrefix    String            @map("api_key_prefix")
  status          PartnerStatus     @default(active)
  accessMode      PartnerAccessMode @default(benefit_only) @map("access_mode")
  premiumIncluded Boolean           @default(true) @map("premium_included")
  webhookUrl      String?           @map("webhook_url")
  webhookSecret   String?           @map("webhook_secret")
  metadata        Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  enrollments IntegrationEnrollment[]
  syncLogs    IntegrationSyncLog[]
  staff       IntegrationStaff[]
  groups      IntegrationGroup[]
  wordPacks   TeacherWordPack[]
  webhookDeliveries PartnerWebhookDelivery[]

  @@map("partners")
}

model IntegrationEnrollment {
  id              String           @id @default(uuid())
  partnerId       String           @map("partner_id")
  /// ERP dagi o'quvchi ID — asosiy sinxron kalit (telefon o'zgarsa ham)
  externalId      String           @map("external_id")
  phone           String
  firstName       String?          @map("first_name")
  lastName        String?          @map("last_name")
  groupName       String?          @map("group_name")
  groupExternalId String?          @map("group_external_id")
  status          EnrollmentStatus @default(active)
  userId          String?          @map("user_id")
  metadata        Json?
  enrolledAt      DateTime         @default(now()) @map("enrolled_at")
  deactivatedAt   DateTime?        @map("deactivated_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([partnerId, externalId])
  @@unique([partnerId, phone])
  @@index([phone, status])
  @@index([partnerId, status])
  @@map("integration_enrollments")
}

model IntegrationSyncLog {
  id             String   @id @default(uuid())
  partnerId      String   @map("partner_id")
  operation      String
  idempotencyKey String?  @map("idempotency_key")
  requestSummary Json?    @map("request_summary")
  resultSummary  Json?    @map("result_summary")
  statusCode     Int      @map("status_code")
  createdAt      DateTime @default(now()) @map("created_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, idempotencyKey])
  @@index([partnerId, createdAt])
  @@map("integration_sync_logs")
}

enum StaffRole {
  teacher
  admin
}

enum StaffStatus {
  active
  inactive
}

enum GroupStatus {
  active
  inactive
}

enum WordPackStatus {
  draft
  published
}

/// ERP dan keladigan xodimlar (o'qituvchi / admin)
model IntegrationStaff {
  id         String      @id @default(uuid())
  partnerId  String      @map("partner_id")
  externalId String      @map("external_id")
  phone      String
  firstName  String?     @map("first_name")
  lastName   String?     @map("last_name")
  role       StaffRole   @default(teacher)
  status     StaffStatus @default(active)
  userId     String?     @map("user_id")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  partner    Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  groups     IntegrationGroup[]
  wordPacks  TeacherWordPack[]

  @@unique([partnerId, externalId])
  @@unique([partnerId, phone])
  @@index([phone, status])
  @@map("integration_staff")
}

/// Guruh / sinf (ERP dan)
model IntegrationGroup {
  id              String      @id @default(uuid())
  partnerId       String      @map("partner_id")
  externalId      String      @map("external_id")
  name            String
  teacherStaffId  String?     @map("teacher_staff_id")
  status          GroupStatus @default(active)
  metadata        Json?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  partner Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  teacher IntegrationStaff? @relation(fields: [teacherStaffId], references: [id], onDelete: SetNull)

  @@unique([partnerId, externalId])
  @@index([partnerId, status])
  @@map("integration_groups")
}

/// O'qituvchi yaratgan so'z to'plami — guruhga publish qilinganda studentlarga tushadi
model TeacherWordPack {
  id              String         @id @default(uuid())
  partnerId       String         @map("partner_id")
  staffId         String         @map("staff_id")
  groupExternalId String         @map("group_external_id")
  title           String
  status          WordPackStatus @default(draft)
  publishedAt     DateTime?      @map("published_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  partner Partner               @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  staff   IntegrationStaff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  items   TeacherWordPackItem[]
  deliveredWords UserWord[]

  @@index([staffId])
  @@index([partnerId, groupExternalId])
  @@map("teacher_word_packs")
}

model TeacherWordPackItem {
  id            String  @id @default(uuid())
  packId        String  @map("pack_id")
  word          String
  translation   String
  pronunciation String?
  definitionEn  String? @map("definition_en")
  exampleEn     String? @map("example_en")
  sortOrder     Int     @default(0) @map("sort_order")

  pack TeacherWordPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId])
  @@map("teacher_word_pack_items")
}

/// Outbound webhook delivery tarixi (WordSwipe → ERP)
model PartnerWebhookDelivery {
  id          String   @id @default(uuid())
  partnerId   String   @map("partner_id")
  event       String
  payload     Json
  statusCode  Int?     @map("status_code")
  success     Boolean  @default(false)
  error       String?
  durationMs  Int?     @map("duration_ms")
  createdAt   DateTime @default(now()) @map("created_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@map("partner_webhook_deliveries")
}
