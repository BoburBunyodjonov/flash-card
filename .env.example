# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/wordswipe

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Telegram (web app uchun kerak, admin panel uchun shart emas)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/bot/webhook

# Shadowing — videolarni maxfiy Telegram kanaldan MTProto (GramJS user sessiya)
# orqali o'qiydi (Bot API'ning 20MB yuklab olish cheklovini chetlab o'tadi).
#   1. api id/hash ni https://my.telegram.org dan oling (API development tools)
#   2. Sessiyani bir marta generatsiya qiling: pnpm --filter api tg:login
#      (kanalga a'zo/egasi bo'lgan akkaunt bilan kiring), chiqqan satrni qo'ying.
# Bo'sh qoldirilsa shadowing video ijrosi o'chadi (metadata baribir ishlaydi).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
# Videolar joylashgan kanal: @username (ochiq) yoki -100… raqamli id (maxfiy).
SHADOWING_CHANNEL_ID=
# Vaqtinchalik LRU kesh (kutubxona EMAS). Ixtiyoriy o'zgartirishlar:
# SHADOWING_CACHE_DIR=/tmp/wordswipe-shadowing
# SHADOWING_CACHE_MAX_MB=2048

# Avto-transkript (shadowing videosidan matn + vaqt belgilari + o'zbekcha tarjima)
# OpenAI-mos endpoint. Standart — Groq (bepul, tez): console.groq.com dan kalit oling.
# Bo'sh qoldirilsa "Avto-transkript" tugmasi ishlamaydi (qo'lda kiritish qoladi).
TRANSCRIBE_API_KEY=
# OpenAI ishlatmoqchi bo'lsangiz: TRANSCRIBE_API_BASE=https://api.openai.com/v1 va TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_API_BASE=https://api.groq.com/openai/v1
# TRANSCRIBE_MODEL=whisper-large-v3-turbo
# TRANSCRIBE_TRANSLATE_MODEL=llama-3.3-70b-versatile

# Admin Panel Login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

# Partner connector secrets (EduPage password, generic REST auth header)
# AES-256-GCM. Generate: openssl rand -hex 32
# Bo'sh qoldirilsa credentials plaintext saqlanadi (faqat local dev).
PARTNER_SECRETS_KEY=

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Payments
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYME_MERCHANT_ID=xxx
PAYME_SECRET_KEY=xxx
CLICK_MERCHANT_ID=xxx
CLICK_SECRET_KEY=xxx

# Google Cloud TTS
GOOGLE_TTS_KEY=xxx

# Firebase Cloud Messaging (push notifications for the Flutter mobile app)
# Leave FCM_CREDENTIALS_JSON empty to disable push (sends become a no-op).
FIREBASE_PROJECT_ID=wordswipe-2dc02
# Service account JSON, base64-encoded (single line — safe for .env):
#   base64 -w0 service-account.json
FCM_CREDENTIALS_JSON=
# Alternative to the above: absolute path to the service account JSON file.
FCM_CREDENTIALS_PATH=
