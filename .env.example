# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/wordswipe

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Telegram (web app uchun kerak, admin panel uchun shart emas)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/bot/webhook

# Admin Panel Login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Payments
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYME_MERCHANT_ID=xxx
PAYME_SECRET_KEY=xxx
CLICK_MERCHANT_ID=xxx
CLICK_SECRET_KEY=xxx

# Google Cloud TTS
GOOGLE_TTS_KEY=xxx

# Firebase Cloud Messaging (push notifications for the Flutter mobile app)
# Leave FCM_CREDENTIALS_JSON empty to disable push (sends become a no-op).
FIREBASE_PROJECT_ID=wordswipe-2dc02
# Service account JSON, base64-encoded (single line — safe for .env):
#   base64 -w0 service-account.json
FCM_CREDENTIALS_JSON=
# Alternative to the above: absolute path to the service account JSON file.
FCM_CREDENTIALS_PATH=
